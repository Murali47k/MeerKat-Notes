---
interface Props {
  title?: string;
  language?: string;
}

const { title, language = 'python' } = Astro.props;
---

<div class="my-6 rounded-2xl border border-blue-200 bg-slate-950 text-slate-100 overflow-hidden shadow-xs">
  {title && (
    <div class="flex items-center justify-between px-5 py-2.5 border-b border-slate-800 bg-slate-900 text-xs font-mono text-slate-400">
      <div class="flex items-center gap-2">
        <span class="inline-block w-2.5 h-2.5 rounded-full bg-blue-500"></span>
        <span class="text-slate-200 font-medium">{title}</span>
      </div>
      <span class="uppercase text-[10px] tracking-wider bg-blue-950 text-blue-300 border border-blue-800 px-2 py-0.5 rounded">
        {language}
      </span>
    </div>
  )}
  <div class="p-5 overflow-x-auto text-sm font-mono leading-relaxed [&>pre]:!bg-transparent [&>pre]:!p-0 [&>pre]:!m-0">
    <slot />
  </div>
</div>
