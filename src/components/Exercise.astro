---
interface Props {
  question?: string;
  hint?: string;
  points?: number;
}

const {
  question = "Practice Checkpoint",
  hint,
  points = 10,
} = Astro.props;
---

<div class="my-6 rounded-2xl border border-blue-200 bg-blue-50/40 p-6 shadow-xs">
  <div class="flex items-center justify-between pb-3 border-b border-blue-200/60 text-xs font-mono">
    <div class="flex items-center gap-2">
      <span class="px-2.5 py-0.5 rounded-md bg-blue-600 text-white font-semibold uppercase tracking-wider text-[10px]">
        Checkpoint
      </span>
      <span class="font-bold text-slate-900">{question}</span>
    </div>
    <span class="text-blue-700 text-[11px] font-semibold">{points} pts</span>
  </div>

  <div class="py-3 text-sm text-slate-800 leading-relaxed font-sans">
    <slot name="question" />
    <slot />
  </div>

  {hint && (
    <details class="mt-2 text-xs font-mono text-slate-600 bg-white p-3 rounded-xl border border-blue-100">
      <summary class="cursor-pointer font-semibold text-blue-600 hover:text-blue-800">
        Hint (click to expand)
      </summary>
      <p class="mt-2 text-slate-600 pl-2 border-l-2 border-blue-400">{hint}</p>
    </details>
  )}

  <details class="mt-3 text-xs font-mono bg-white p-3.5 rounded-xl border border-blue-100">
    <summary class="cursor-pointer font-bold text-blue-900 hover:text-blue-700 flex items-center justify-between">
      <span>View Mathematical Solution & Derivation</span>
      <span class="text-[10px] text-blue-500 font-normal">Click to expand</span>
    </summary>
    <div class="mt-3 pt-3 border-t border-blue-50 text-sm font-sans text-slate-700 leading-relaxed">
      <slot name="solution" />
    </div>
  </details>
</div>
