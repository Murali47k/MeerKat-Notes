---
interface Props {
  title?: string;
  badge?: string;
}

const { title = "Fun Fact", badge = "Did you know?" } = Astro.props;
---

<aside class="my-8 rounded-2xl border border-emerald-200 bg-gradient-to-br from-emerald-50/70 via-emerald-50/30 to-white p-6 sm:p-7 shadow-xs">
  <div class="flex flex-wrap items-center justify-between gap-2 border-b border-emerald-100 pb-3 mb-4">
    <div class="flex items-center gap-2.5">
      <span class="inline-block w-3 h-3 rounded-full bg-emerald-500 shadow-xs"></span>
      <h3 class="text-xl sm:text-2xl font-extrabold text-emerald-950 tracking-tight font-sans !m-0">
        {title}
      </h3>
    </div>
    {badge && (
      <span class="font-mono text-[11px] font-bold uppercase tracking-wider text-emerald-700 bg-emerald-100/80 border border-emerald-200 px-2.5 py-0.5 rounded-md">
        {badge}
      </span>
    )}
  </div>
  <div class="text-slate-800 text-sm sm:text-base leading-relaxed space-y-3 [&>p]:!my-2 [&>div]:!my-3">
    <slot />
  </div>
</aside>
