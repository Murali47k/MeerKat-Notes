---
interface Props {
  src: string;
  title?: string;
  caption?: string;
  poster?: string;
  aspectRatio?: string;
}

const {
  src,
  title = "Mathematical Concept Animation",
  caption,
  poster,
  aspectRatio = "16/9",
} = Astro.props;

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const resolvedSrc = src.startsWith('http') || src.startsWith(base) ? src : `${base}${src.startsWith('/') ? src : `/${src}`}`;
const resolvedPoster = poster && !(poster.startsWith('http') || poster.startsWith(base)) ? `${base}${poster.startsWith('/') ? poster : `/${poster}`}` : poster;
---

<div class="my-8 rounded-2xl border border-blue-100 bg-white overflow-hidden shadow-xs">
  <div class="flex items-center justify-between px-5 py-3 bg-slate-900 text-white border-b border-slate-800">
    <div class="flex items-center gap-2.5">
      <span class="inline-flex items-center justify-center w-5 h-5 rounded bg-blue-600 text-white font-mono text-[10px] font-bold">
        M
      </span>
      <span class="text-xs font-mono text-slate-200 font-medium">{title}</span>
    </div>
    <span class="text-[10px] font-mono uppercase tracking-wider text-blue-300 bg-blue-950/80 border border-blue-800/60 px-2 py-0.5 rounded">
      Manim Render
    </span>
  </div>

  <div class="relative bg-slate-950 flex items-center justify-center" style={`aspect-ratio: ${aspectRatio};`}>
    <video
      controls
      loop
      playsinline
      poster={resolvedPoster}
      class="w-full h-full object-contain"
    >
      <source src={resolvedSrc} type="video/mp4" />
      Your browser does not support the video tag.
    </video>
  </div>

  {caption && (
    <div class="px-5 py-3 bg-blue-50/40 border-t border-blue-100 text-xs font-mono text-slate-600 flex items-start gap-2.5">
      <span class="text-blue-700 bg-blue-100/70 border border-blue-200 text-[10px] font-bold px-1.5 py-0.5 rounded shrink-0">NOTE</span>
      <span>{caption}</span>
    </div>
  )}
</div>
