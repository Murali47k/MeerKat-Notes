---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Notes — Mathematics behind ML",
  description = "Interactive machine learning notes, mathematical derivations, interactive React experiments, and Manim animations.",
} = Astro.props;
---

<!doctype html>
<html lang="en" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />

    <!-- Google Fonts: Plus Jakarta Sans & JetBrains Mono -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500;600;700&family=Plus+Jakarta+Sans:ital,wght@0,300..800;1,300..800&display=swap"
      rel="stylesheet"
    />
  </head>
  <body class="min-h-screen bg-notebook-grid text-slate-900 flex flex-col selection:bg-blue-600 selection:text-white">
    <!-- Top Minimal Navigation -->
    <header class="border-b border-slate-200/80 bg-white/90 backdrop-blur-md sticky top-0 z-40 transition-colors">
      <div class="max-w-4xl mx-auto px-4 sm:px-6 h-16 flex items-center justify-between">
        <a href="/" class="flex items-center gap-3 group">
          <div class="w-8 h-8 rounded-lg bg-blue-600 text-white font-mono text-sm font-bold flex items-center justify-center shadow-xs group-hover:bg-blue-700 transition-colors">
            N
          </div>
          <div class="flex flex-col">
            <span class="font-mono text-sm tracking-tight font-bold text-slate-900 group-hover:text-blue-600 transition-colors">
              Notes
            </span>
            <span class="text-[10px] font-mono text-slate-400 -mt-0.5 tracking-wider uppercase">
              ML Notebook
            </span>
          </div>
        </a>

        <nav class="flex items-center gap-1 sm:gap-2 text-xs font-mono">
          <a
            href="/"
            class="text-slate-600 hover:text-blue-600 hover:bg-blue-50/80 px-3 py-1.5 rounded-lg transition-colors font-medium"
          >
            Home
          </a>
          <a
            href="/notebooks/mathematics-ml"
            class="text-slate-600 hover:text-blue-600 hover:bg-blue-50/80 px-3 py-1.5 rounded-lg transition-colors font-medium"
          >
            Curriculum
          </a>
          <a
            href="/notebooks/mathematics-ml/01-linear-regression"
            class="text-blue-700 bg-blue-50 hover:bg-blue-100 border border-blue-200/70 px-3 py-1.5 rounded-lg transition-all font-semibold flex items-center gap-1.5"
          >
            <span class="w-1.5 h-1.5 rounded-full bg-blue-600"></span>
            Chapter 01
          </a>
          <a
            href="https://github.com/Murali47k/MeerKat-Notes"
            target="_blank"
            rel="noopener noreferrer"
            class="text-slate-500 hover:text-slate-900 px-2.5 py-1.5 rounded-lg transition-colors font-medium hidden sm:inline-block"
          >
            GitHub
          </a>
        </nav>
      </div>
    </header>

    <!-- Page Body: Elevated White Notebook Sheet casting a soft shadow on the Grid -->
    <main class="flex-1 max-w-4xl w-full mx-auto px-3 sm:px-6 py-6 sm:py-10">
      <div class="bg-white rounded-2xl sm:rounded-3xl border border-slate-200/90 shadow-[0_12px_45px_-12px_rgba(15,23,42,0.09),0_2px_8px_rgba(15,23,42,0.04)] p-6 sm:p-10 md:p-12 relative">
        <slot />
      </div>
    </main>

    <!-- Footer -->
    <footer class="border-t border-slate-200/80 py-8 bg-white/80 backdrop-blur-xs text-xs font-mono text-slate-500">
      <div class="max-w-4xl mx-auto px-4 sm:px-6 flex flex-col sm:flex-row items-center justify-between gap-3">
        <p>© {new Date().getFullYear()} Notes · Created by <strong class="text-slate-700">Murali</strong></p>
        <div class="flex items-center gap-3 text-slate-400 font-medium">
          <span class="text-blue-600">Astro</span>
          <span>·</span>
          <span>MDX</span>
          <span>·</span>
          <span>React</span>
          <span>·</span>
          <span>Manim</span>
          <span>·</span>
          <span>KaTeX</span>
        </div>
      </div>
    </footer>
  </body>
</html>
