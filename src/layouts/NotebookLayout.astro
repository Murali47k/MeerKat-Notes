---
import MainLayout from './MainLayout.astro';
import type { NotebookItem } from '../utils/content';

interface Props {
  notebook: NotebookItem;
}

const { notebook } = Astro.props;
---

<MainLayout
  title={`${notebook.title} — Notes`}
  description={notebook.description}
>
  <div class="space-y-10">
    <!-- Breadcrumb -->
    <div class="flex items-center gap-2 text-xs font-mono text-slate-500">
      <a href="/" class="hover:text-blue-600 transition-colors">Catalog</a>
      <span class="text-blue-300">/</span>
      <span class="text-blue-900 font-medium">{notebook.slug}</span>
    </div>

    <!-- Notebook Header -->
    <div class="border-b border-blue-100 pb-8 bg-white p-6 sm:p-8 rounded-2xl border shadow-xs">
      <div class="flex items-center gap-2 mb-3">
        <span class="font-mono text-xs uppercase tracking-wider text-blue-700 bg-blue-50 border border-blue-200 px-2.5 py-0.5 rounded-md font-semibold">
          {notebook.type}
        </span>
        <span class="font-mono text-xs text-blue-700 bg-blue-50 border border-blue-200 px-2.5 py-0.5 rounded-md">
          {notebook.level}
        </span>
        <span class="font-mono text-xs text-slate-600 bg-slate-50 border border-slate-200 px-2.5 py-0.5 rounded-md">
          {notebook.category}
        </span>
      </div>

      <h1 class="text-3xl sm:text-4xl font-bold tracking-tight text-slate-900">
        {notebook.title}
      </h1>

      <p class="mt-3 text-base text-slate-600 leading-relaxed font-sans">
        {notebook.description}
      </p>
    </div>

    <!-- Chapters Section -->
    <div>
      <div class="flex items-center justify-between mb-4">
        <h2 class="font-mono text-xs font-semibold uppercase tracking-wider text-blue-600/80">
          CHAPTERS IN THIS NOTEBOOK ({notebook.chapters.length})
        </h2>
        <span class="text-xs font-mono text-slate-400">
          Estimated: {notebook.chapters.reduce((acc, c) => acc + c.readingTime, 0)} mins total
        </span>
      </div>

      <div class="space-y-3">
        {notebook.chapters.map((chap, idx) => (
          <a
            href={chap.url}
            class="group block bg-white border border-blue-100 rounded-xl p-5 hover:border-blue-400 hover:shadow-md hover:shadow-blue-500/5 transition-all cursor-pointer"
          >
            <div class="flex items-start sm:items-center justify-between gap-4">
              <div class="flex items-start sm:items-center gap-4">
                <div class="w-9 h-9 rounded-lg border border-blue-200 bg-blue-50 flex items-center justify-center font-mono text-xs font-bold text-blue-700 group-hover:bg-blue-600 group-hover:text-white group-hover:border-blue-600 transition-all shrink-0">
                  {String(idx + 1).padStart(2, '0')}
                </div>
                <div>
                  <h3 class="font-mono text-[15px] font-semibold text-slate-900 group-hover:text-blue-600 transition-colors">
                    {chap.title}
                  </h3>
                  {chap.description && (
                    <p class="text-xs text-slate-500 mt-0.5 font-sans leading-normal">
                      {chap.description}
                    </p>
                  )}
                </div>
              </div>

              <div class="flex items-center gap-3 shrink-0">
                <span class="font-mono text-xs text-slate-400">
                  {chap.readingTime} min
                </span>
                <span class="text-blue-400 group-hover:text-blue-700 group-hover:translate-x-1 transition-all text-sm font-mono font-bold">
                  →
                </span>
              </div>
            </div>
          </a>
        ))}
      </div>
    </div>
  </div>
</MainLayout>
