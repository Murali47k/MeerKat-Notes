---
import MainLayout from './MainLayout.astro';
import type { NotebookItem } from '../utils/content';
import { withBase } from '../utils/content';

interface Props {
  notebook: NotebookItem;
}

const { notebook } = Astro.props;
---

<MainLayout
  title={`${notebook.title} — Meerkat Notes`}
  description={notebook.description}
>
  <div class="space-y-8">
    <!-- Breadcrumb -->
    <div class="flex items-center gap-2 text-xs font-mono text-slate-500">
      <a href={withBase('/')} class="hover:text-blue-600 transition-colors flex items-center gap-1">
        <span>←</span> Catalog
      </a>
      <span class="text-slate-300">/</span>
      <span class="text-blue-600 font-semibold">{notebook.slug}</span>
    </div>

    <!-- Notebook Header Card -->
    <div class="relative bg-white border border-slate-200/90 rounded-2xl shadow-sm overflow-hidden">
      <div class="h-1.5 w-full bg-gradient-to-r from-blue-600 via-indigo-500 to-sky-400"></div>

      <div class="p-7 sm:p-9">
        <div class="flex flex-wrap items-center gap-2 mb-3">
          <span class="font-mono text-xs uppercase tracking-wider text-blue-700 bg-blue-50 border border-blue-200 px-3 py-1 rounded-md font-bold">
            {notebook.type}
          </span>
          <span class="font-mono text-xs text-blue-700 bg-blue-50 border border-blue-200 px-3 py-1 rounded-md font-medium">
            {notebook.level}
          </span>
          <span class="font-mono text-xs text-slate-600 bg-slate-100 border border-slate-200 px-3 py-1 rounded-md font-medium">
            {notebook.category}
          </span>
          <span class="font-mono text-xs text-slate-500 ml-auto">
            Author: <strong class="text-slate-700">{notebook.author}</strong>
          </span>
        </div>

        <h1 class="text-3xl sm:text-4xl md:text-5xl font-black tracking-tight text-slate-900 leading-tight">
          {notebook.title}
        </h1>

        <p class="mt-4 text-base sm:text-lg text-slate-600 leading-relaxed font-sans max-w-3xl">
          {notebook.description}
        </p>
      </div>
    </div>

    <!-- Chapters Section -->
    <div>
      <div class="flex items-center justify-between mb-4">
        <h2 class="font-mono text-xs font-bold uppercase tracking-wider text-slate-500 flex items-center gap-2">
          <span class="w-2 h-2 rounded-full bg-blue-600"></span>
          CURRICULUM CHAPTERS ({notebook.chapters.length})
        </h2>
        <span class="text-xs font-mono text-slate-400">
          Estimated: {notebook.chapters.reduce((acc, c) => acc + c.readingTime, 0)} mins total
        </span>
      </div>

      <div class="space-y-3">
        {notebook.chapters.map((chap, idx) => (
          <a
            href={chap.url}
            class="group block bg-white border border-slate-200/90 rounded-2xl p-6 hover:border-blue-400 hover:shadow-md hover:shadow-blue-500/5 transition-all cursor-pointer"
          >
            <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
              <div class="flex items-start sm:items-center gap-4">
                <div class="w-10 h-10 rounded-xl bg-blue-50 border border-blue-200 text-blue-700 font-mono text-sm font-bold flex items-center justify-center group-hover:bg-blue-600 group-hover:text-white group-hover:border-blue-600 transition-all shrink-0">
                  {String(idx + 1).padStart(2, '0')}
                </div>
                <div>
                  <h3 class="font-mono text-base sm:text-lg font-bold text-slate-900 group-hover:text-blue-600 transition-colors">
                    {chap.title}
                  </h3>
                  {chap.description && (
                    <p class="text-xs sm:text-sm text-slate-500 mt-1 font-sans leading-relaxed">
                      {chap.description}
                    </p>
                  )}
                </div>
              </div>

              <div class="flex items-center gap-3 shrink-0 sm:self-center self-end">
                <span class="font-mono text-xs text-slate-500 bg-slate-100 px-2.5 py-1 rounded-md">
                  {chap.readingTime} min read
                </span>
                <span class="inline-flex items-center justify-center w-8 h-8 rounded-lg bg-blue-50 text-blue-600 group-hover:bg-blue-600 group-hover:text-white transition-all text-sm font-bold">
                  →
                </span>
              </div>
            </div>
          </a>
        ))}
      </div>
    </div>
  </div>
</MainLayout>
