---
import MainLayout from '../layouts/MainLayout.astro';
import CatalogSearch from '../components/CatalogSearch.tsx';
import { getAllNotebooks } from '../utils/content';

const notebooks = await getAllNotebooks();

const notes = notebooks.map((nb) => ({
  id: nb.id,
  slug: nb.slug,
  title: nb.title,
  description: nb.description,
  type: nb.type,
  author: nb.author,
  chaptersCount: nb.chapters.length,
  url: `/notebooks/${nb.slug}`,
  level: nb.level,
}));
---

<MainLayout title="Notes — Mathematics behind ML Algorithms">
  <div class="max-w-3xl mx-auto pt-4 sm:pt-8">
    <!-- Hero Header - Unique & Professional Notebook Styling -->
    <div class="mb-10 text-left">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-md bg-blue-50 border border-blue-200/90 text-blue-700 font-mono text-xs font-semibold mb-4 tracking-wider uppercase shadow-2xs">
        <span class="w-1.5 h-1.5 rounded-full bg-blue-600"></span>
        TECHNICAL NOTEBOOK
      </div>

      <h1 class="text-5xl sm:text-6xl md:text-7xl font-extrabold tracking-tight text-slate-900 leading-none">
        Notes<span class="text-blue-600">.</span>
      </h1>

      <p class="mt-4 text-base sm:text-lg text-slate-600 font-sans max-w-2xl leading-relaxed">
        Personal interactive notes, mathematical derivations, interactive React experiments, and Manim animations.
      </p>

      <!-- Feature Badges without emojis -->
      <div class="flex flex-wrap items-center gap-2 mt-5 text-xs font-mono text-slate-700">
        <span class="px-3 py-1 rounded-md bg-white border border-slate-300 font-medium shadow-2xs">
          KaTeX Derivations
        </span>
        <span class="px-3 py-1 rounded-md bg-white border border-slate-300 font-medium shadow-2xs">
          Interactive Visualizations
        </span>
        <span class="px-3 py-1 rounded-md bg-white border border-slate-300 font-medium shadow-2xs">
          Manim Animations
        </span>
        <span class="px-3 py-1 rounded-md bg-white border border-slate-300 font-medium shadow-2xs">
          Python Implementations
        </span>
      </div>
    </div>

    <!-- Search and Note Catalogue Filter -->
    <CatalogSearch client:load initialNotes={notes} />
  </div>
</MainLayout>
