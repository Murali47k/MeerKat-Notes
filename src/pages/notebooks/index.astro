---
import MainLayout from '../../layouts/MainLayout.astro';
import { getAllNotebooks, withBase } from '../../utils/content';

const notebooks = await getAllNotebooks();
---

<MainLayout
  title="Meerkat Notes — Curriculum"
  description="Explore technical notebooks, interactive visualizations, and mathematical derivations."
>
  <div class="space-y-8">
    <div class="border-b border-slate-200/80 pb-6">
      <span class="font-mono text-xs uppercase tracking-widest text-blue-600 font-bold">
        CURRICULUM
      </span>
      <h1 class="text-3xl sm:text-4xl font-black tracking-tight text-slate-900 mt-1">
        Technical Notebooks
      </h1>
      <p class="text-base text-slate-600 mt-2 font-sans">
        Structured learning paths combining mathematical foundations, interactive experiments, and Python implementations.
      </p>
    </div>

    <div class="grid grid-cols-1 gap-5">
      {notebooks.map((nb) => (
        <a
          href={withBase(`/notebooks/${nb.slug}`)}
          class="group block bg-white border border-slate-200/90 rounded-2xl p-7 hover:border-blue-400 hover:shadow-md hover:shadow-blue-500/5 transition-all"
        >
          <div class="flex items-center justify-between gap-2 mb-3">
            <div class="flex items-center gap-2">
              <span class="font-mono text-[11px] font-bold text-blue-700 bg-blue-50 border border-blue-200 px-2.5 py-0.5 rounded-md uppercase">
                {nb.type}
              </span>
              <span class="font-mono text-[11px] text-slate-600 bg-slate-100 px-2.5 py-0.5 rounded-md">
                {nb.level}
              </span>
            </div>
            <span class="font-mono text-xs text-blue-600 font-semibold bg-blue-50 px-2.5 py-0.5 rounded-md">
              {nb.chapters.length} Chapter Available
            </span>
          </div>

          <h3 class="text-xl sm:text-2xl font-bold text-slate-900 group-hover:text-blue-600 transition-colors">
            {nb.title}
          </h3>

          <p class="text-sm sm:text-base text-slate-600 mt-2 font-sans leading-relaxed">
            {nb.description}
          </p>

          <div class="flex items-center justify-between mt-6 pt-4 border-t border-slate-100 text-xs font-mono">
            <span class="text-slate-500">Author: <strong class="text-slate-700">{nb.author}</strong></span>
            <span class="text-blue-600 font-bold group-hover:translate-x-1 transition-transform inline-flex items-center gap-1">
              <span>View Chapters</span>
              <span>→</span>
            </span>
          </div>
        </a>
      ))}
    </div>
  </div>
</MainLayout>
