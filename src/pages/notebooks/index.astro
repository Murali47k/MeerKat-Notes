---
import MainLayout from '../../layouts/MainLayout.astro';
import { getAllNotebooks } from '../../utils/content';

const notebooks = await getAllNotebooks();
---

<MainLayout
  title="Notebooks — Mathematics behind ML"
  description="Explore technical notebooks, interactive visualizations, and mathematical derivations."
>
  <div class="space-y-8">
    <div class="border-b border-blue-100 pb-6">
      <span class="font-mono text-xs uppercase tracking-widest text-blue-600 font-semibold">
        CURRICULUM
      </span>
      <h1 class="text-3xl font-bold tracking-tight text-slate-900 mt-1">
        Technical Notebooks
      </h1>
      <p class="text-sm font-mono text-slate-500 mt-2">
        Structured learning paths combining theory, mathematical animations, and interactive experiments.
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
      {notebooks.map((nb) => (
        <a
          href={`/notebooks/${nb.slug}`}
          class="group block bg-white border border-blue-100 rounded-xl p-6 hover:border-blue-400 hover:shadow-md hover:shadow-blue-500/5 transition-all"
        >
          <div class="flex items-center justify-between gap-2 mb-3">
            <span class="font-mono text-[11px] font-semibold text-blue-700 bg-blue-50 border border-blue-200 px-2.5 py-0.5 rounded-md uppercase">
              {nb.type}
            </span>
            <span class="font-mono text-xs text-slate-400">
              {nb.chapters.length} chapter{nb.chapters.length !== 1 ? 's' : ''}
            </span>
          </div>

          <h3 class="font-mono text-base font-semibold text-slate-900 group-hover:text-blue-600 transition-colors">
            {nb.title}
          </h3>

          <p class="text-xs text-slate-500 mt-1.5 line-clamp-2 font-sans leading-relaxed">
            {nb.description}
          </p>

          <div class="flex items-center justify-between mt-5 pt-3 border-t border-blue-50 text-xs font-mono">
            <span class="text-blue-600 font-medium">{nb.level}</span>
            <span class="text-blue-400 group-hover:text-blue-700 group-hover:translate-x-1 transition-all font-bold">
              Explore →
            </span>
          </div>
        </a>
      ))}
    </div>
  </div>
</MainLayout>
